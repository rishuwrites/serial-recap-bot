# Existing generation and YouTube settings.
GEMINI_API_KEY=
HF_FLUX_SPACE=https://black-forest-labs-flux-1-schnell.hf.space
YT_API_KEY=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
